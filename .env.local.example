# Copy this file to .env.local on your Mac. Do not commit .env.local.
# You may obtain these values from a private SSH-tunnel setup or a local stack.
export PRODUCTSHOT_DEV_SSH_HOST=your-ssh-host-alias
export PRODUCTSHOT_REDIS_LOCAL_PORT=16379
export PRODUCTSHOT_POSTGRES_LOCAL_PORT=15432
export DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:15432/productshot
export CELERY_BROKER_URL=redis://:password@127.0.0.1:16379/0
export CELERY_RESULT_BACKEND=redis://:password@127.0.0.1:16379/1

